# Required: Groq inference key (free tier). https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: override the default model.
# AGENT_MODEL=openai/gpt-oss-120b

# Optional: LangSmith tracing. With these set, every graph run is traced
# automatically by LangChain. Without them the local JSON traces in traces/
# are still written by harness/trace.py.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your_key_here
# LANGSMITH_PROJECT=langgraph-research-harness
